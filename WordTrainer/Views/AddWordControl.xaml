<UserControl x:Class="WordTrainer.Views.AddWordControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="500">
    <Grid Margin="20,20,20,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="47"/>
            <RowDefinition Height="Auto" MinHeight="71"/>
            <RowDefinition Height="42.125"/>
            <RowDefinition Height="Auto" MinHeight="106"/>
            <RowDefinition Height="Auto" MinHeight="33"/>
            <RowDefinition Height="Auto" MinHeight="160.875"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto" MinWidth="160"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Слово на иностранном языке" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center" FontSize="16" Height="20"/>
        <TextBox Text="{Binding Original}" Margin="0,0,10,0" Grid.Column="1" VerticalAlignment="Center" FontSize="16" Padding="5" Height="32"/>

        <TextBlock Text="Перевод на русский" Margin="0,0,10,0" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="16" Height="22"/>
        <TextBox Text="{Binding Translation}" Margin="0,0,10,0" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="16" Padding="5" Height="34"/>

        <TextBlock Text="Категория" Margin="0,0,10,0" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="16" Height="21"/>
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,10,0" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="16" Padding="5" Height="34"/>

        <Button Command="{Binding AddWordCommand}" Content="Добавить новое слово" Grid.Row="3" VerticalAlignment="Top" FontSize="16" Padding="10,5" BorderBrush="#FFCDC2DA" Background="#FFB180EA" Height="40" Margin="0,10,10,0" Grid.ColumnSpan="2"/>

        <TextBlock Text="Создать новую категорию" Margin="0,0,10,0" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontSize="16" Height="21"/>
        <TextBox Text="{Binding NewCategory}" Margin="0,0,10,0" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" FontSize="16" Padding="5" Height="33"/>

        <Button Command="{Binding AddCategoryCommand}" Content="Добавить новую категорию" Grid.Row="5" VerticalAlignment="Top" FontSize="16" Padding="10,5" Height="40" Background="#FFB180EA" BorderBrush="#FFD9C8ED" Margin="0,10,10,0" Grid.ColumnSpan="2" />
    </Grid>
</UserControl>
