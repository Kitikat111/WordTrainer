<Window x:Class="WordTrainer.Views.MainMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word Trainer" Height="550" Width="500">
    <Window.Background>
        <ImageBrush ImageSource="/Views/d952f6cb032b1249123cb3502886e3f4.jpg"/>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="215*"/>
            <RowDefinition Height="32*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10,7,245,0" Grid.Row="1">
            <Button Content="Тест" Command="{Binding OpenTestWindowCommand}" FontSize="16" Padding="10,5" IsEnabled="{Binding IsTestEnabled}" Width="200" Background="Goldenrod" Foreground="Black" Height="34" FontFamily="RomanT" />

        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="235,7,0,0" Grid.Row="1">
            <Button Content="Добавить слово" Command="{Binding OpenAddWordWindowCommand}" FontSize="16" Padding="10,5" IsEnabled="{Binding IsAddWordEnabled}" Width="218" Background="Goldenrod" Foreground="Black" Height="34" FontFamily="RomanT" />
        </StackPanel>

        <ContentControl Content="{Binding CurrentView}" Grid.RowSpan="1"/>
    </Grid>
</Window>
